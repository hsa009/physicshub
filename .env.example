# ─── Frontend (Vite) ───
# These are PUBLIC — the browser sees them. Anon key is safe to ship;
# row-level security on Supabase keeps students inside their own data.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=ey...your-anon-key...

# URL of the deployed Cloudflare Worker (set after first `wrangler deploy`).
VITE_WORKER_URL=https://physicshub-worker.your-subdomain.workers.dev
